# Entity Resolution Pipeline Configuration
# Copy this file to .env or set environment variables in your shell environment.

# Force UTF-8 encoding across Python processes (recommended on Windows)
PYTHONUTF8=1

# Add the entity resolution library to Python's module search path
PYTHONPATH=code/business_entity_resolution/src

# DuckDB memory limit (MB) for candidate generation / blocking queries (default: 700)
ER_DUCKDB_MEMORY_MB=700

# DuckDB memory limit (MB) for physical feature materialization (recommended: 1200, default: 700)
ER_FEATURE_DUCKDB_MEMORY_MB=1200

# Directory for intermediate feature parquet spills and scratch tables
ER_TEST_FEATURE_TMP_DIR=work/test_features/tmp
